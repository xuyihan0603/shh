.sheet{padding:40rpx 32rpx 72rpx}.heading{font-weight:650;font-size:50rpx;color:#173c32;margin:12rpx 0 36rpx}.panel,.block{padding:36rpx;border-radius:24rpx;background:#fff;border:1rpx solid #e1e6dd;margin-bottom:28rpx}.panel{background:#204b3d;color:#fff}.eyebrow{font-size:24rpx;color:#c7dccc}.store-name{font-size:40rpx;font-weight:600;margin:12rpx 0 18rpx}.line{font-size:27rpx;line-height:1.65}.section-title{font-size:32rpx;font-weight:600}.sub{font-size:26rpx;color:#57675d;line-height:1.6;margin:14rpx 0 22rpx}.sheet input{height:86rpx;border-bottom:1rpx solid #dee4db;font-size:29rpx}.primary,.secondary{margin:24rpx 0 0;text-align:center;font-size:29rpx;line-height:84rpx;border-radius:14rpx}.primary{color:#fff;background:#20513f}.secondary{color:#224a3a;background:#eaf0e8}.error{color:#963c32;background:#fff0e9;padding:22rpx;border-radius:12rpx;margin:16rpx 0}.sheet button::after{border:0}

.store-page {
  --store-deep: #103947;
  --store-sea: #e8f1f1;
  --store-pearl: #f6f4ee;
  --store-bronze: #bd9354;
  --store-gold: #805e30;
  --store-gold-light: #f8efdf;
  --store-ink: #203940;
  --store-muted: #4e676d;
  --store-border: #d6e1e1;
  min-height: 100vh;
  padding: 26rpx 28rpx 52rpx;
  padding-bottom: calc(52rpx + env(safe-area-inset-bottom));
  background: var(--store-pearl);
  color: var(--store-ink);
  font-size: 28rpx;
  line-height: 1.5;
}

.store-card {
  padding: 26rpx;
  border: 1rpx solid var(--store-border);
  border-radius: 22rpx;
  background: #fff;
}

.store-heading {
  color: var(--store-deep);
  font-size: 34rpx;
  font-weight: 650;
  line-height: 1.34;
  word-break: break-word;
}

.store-caption { color: var(--store-muted); font-size: 25rpx; }

.store-button,
.store-link {
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0;
  font-weight: 600;
  line-height: 1.35;
  text-align: center;
}

.store-button {
  min-height: 82rpx;
  padding: 12rpx 22rpx;
  border: 1rpx solid transparent;
  border-radius: 14rpx;
  font-size: 28rpx;
}

.store-button-primary { background: var(--store-deep); color: #fff; }
.store-button-secondary { background: var(--store-sea); color: var(--store-deep); }
.store-button-quiet { border-color: var(--store-border); background: #fff; color: var(--store-deep); }
.store-button[disabled] { border-color: var(--store-border); background: #edf0ef; color: #5d7175; opacity: 1; }

.store-link {
  min-height: 60rpx;
  padding: 6rpx 0;
  background: transparent;
  color: var(--store-deep);
  font-size: 26rpx;
}

.store-date { display: block; min-width: 0; }
.store-date-label { color: var(--store-muted); font-size: 24rpx; }
.store-date-value {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 4rpx;
  color: var(--store-deep);
  font-size: 36rpx;
  font-weight: 650;
  font-variant-numeric: tabular-nums;
  line-height: 1.22;
}

.store-chevron { flex-shrink: 0; color: var(--store-muted); font-size: 30rpx; line-height: 1; }

.store-switch {
  display: flex;
  gap: 5rpx;
  padding: 5rpx;
  border-radius: 14rpx;
  background: var(--store-sea);
}

.store-option {
  flex: 1;
  min-height: 55rpx;
  margin: 0;
  padding: 9rpx 14rpx;
  border-radius: 10rpx;
  background: transparent;
  color: var(--store-muted);
  font-size: 26rpx;
  line-height: 1.3;
  white-space: nowrap;
}

.store-option-active { background: var(--store-deep); color: #fff; font-weight: 650; }

.store-field-label {
  display: block;
  margin-bottom: 9rpx;
  color: var(--store-deep);
  font-size: 26rpx;
  font-weight: 600;
}

.store-input {
  width: 100%;
  height: 88rpx;
  padding: 0 20rpx;
  border: 1rpx solid #afc1c2;
  border-radius: 12rpx;
  background: #f7faf9;
  color: var(--store-ink);
  font-size: 30rpx;
}

.store-placeholder { color: #576f75; }

.store-state {
  color: var(--store-muted);
  font-size: 27rpx;
  line-height: 1.55;
}

.store-state .store-link { justify-content: flex-start; margin-top: 8rpx; }
.store-error {
  padding: 18rpx 22rpx;
  border: 1rpx solid #efd9d1;
  border-radius: 14rpx;
  background: #fff3ee;
  color: #813b35;
  font-size: 26rpx;
  line-height: 1.55;
  word-break: break-word;
}
