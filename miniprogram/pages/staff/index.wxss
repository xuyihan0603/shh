@import "../../styles/settings.wxss";

.staff-page .store-error { margin-bottom: 18rpx; }
.staff-retry { width: 100%; margin-top: 18rpx; }
.staff-item { padding: 21rpx 24rpx; }
.staff-item + .staff-item { margin-top: 13rpx; }
.staff-item-editing { border-color: #9ab6b8; }

.staff-summary {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 20rpx;
}

.staff-person { flex: 1; min-width: 0; }
.staff-name { color: var(--store-deep); font-size: 31rpx; font-weight: 650; line-height: 1.3; word-break: break-word; }
.staff-meta { margin-top: 6rpx; word-break: break-word; }

.staff-marker, .staff-role {
  display: inline-block;
  padding: 5rpx 12rpx;
  border-radius: 8rpx;
  background: var(--store-sea);
  color: var(--store-deep);
  font-size: 24rpx;
  line-height: 1.35;
}

.staff-marker { margin-top: 8rpx; background: #edf0ef; color: var(--store-muted); }
.staff-self { background: var(--store-sea); color: var(--store-deep); }
.staff-role { font-weight: 600; }
.staff-role-manager { background: var(--store-gold-light); color: var(--store-gold); }
.staff-position { flex-shrink: 0; text-align: right; }

.staff-links { display: flex; justify-content: flex-end; gap: 24rpx; margin: 5rpx 0 -7rpx; }
.staff-edit { min-height: 74rpx; padding: 8rpx 4rpx; }

.staff-editor {
  padding: 17rpx;
  margin-top: 18rpx;
  border-radius: 14rpx;
  background: #f0f6f5;
}

.staff-picker {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 10rpx;
  background: #fff;
}

.staff-field + .staff-field, .staff-profile-error { margin-top: 16rpx; }

.staff-actions { display: flex; gap: 14rpx; margin-top: 15rpx; }
.staff-actions .store-button { flex: 1; }
.staff-actions .staff-save { flex: 1.5; }
