@import "../../lib/reception.wxss";

.invite-card {
  padding: 32rpx 26rpx 26rpx;
  border-top: 4rpx solid #bd9354;
  text-align: center;
}

.invite-logo {
  display: block;
  width: 254rpx;
  margin: 0 auto 20rpx;
  border-radius: 12rpx;
  background: #fff;
}

.invite-store {
  margin-bottom: 22rpx;
  color: #103947;
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1.25;
  word-break: break-word;
}

.invite-schedule {
  display: flex;
  flex-wrap: wrap;
  align-items: baseline;
  justify-content: center;
  gap: 6rpx 16rpx;
  padding: 18rpx;
  border-radius: 13rpx;
  background: #103947;
  color: #f6f4ee;
  font-size: 29rpx;
}

.invite-date {
  font-weight: 650;
}

.invite-seating {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  margin-top: 12rpx;
  padding: 16rpx;
  border-radius: 13rpx;
  background: #e8f1f1;
  color: #103947;
}

.invite-guests {
  font-size: 31rpx;
  font-weight: 650;
}

.invite-tables,
.invite-line {
  color: #405b63;
  font-size: 27rpx;
  line-height: 1.6;
  word-break: break-word;
}

.invite-contact {
  margin-top: 18rpx;
}

.invite-line,
.invite-error {
  margin-top: 10rpx;
}

.invite-action {
  display: flex;
  width: 100%;
  min-height: 82rpx;
  margin-top: 16rpx;
}
