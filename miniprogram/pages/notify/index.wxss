@import "../../lib/reception.wxss";

.notify-notice,
.notify-panel {
  margin-bottom: 18rpx;
}

.notify-phone {
  display: block;
  margin-top: 14rpx;
  color: #103947;
  font-size: 36rpx;
  font-variant-numeric: tabular-nums;
  font-weight: 650;
  word-break: break-word;
}

.notify-message {
  display: block;
  margin-top: 16rpx;
  padding: 22rpx;
  border-radius: 14rpx;
  background: #e8f1f1;
  color: #103947;
  font-size: 29rpx;
  line-height: 1.65;
  white-space: pre-wrap;
  word-break: break-word;
}

.notify-action {
  display: flex;
  width: 100%;
  min-height: 82rpx;
  margin-top: 18rpx;
}

.notify-action + .notify-action {
  margin-top: 12rpx;
}

.notify-hint,
.notify-feedback,
.notify-success,
.notify-diagnostic {
  margin-top: 14rpx;
}

.notify-hint {
  font-size: 26rpx;
}

.notify-diagnostic {
  display: block;
  overflow-wrap: anywhere;
}

.notify-success {
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  background: #e8f1f1;
  color: #103947;
  font-size: 26rpx;
  line-height: 1.55;
}
