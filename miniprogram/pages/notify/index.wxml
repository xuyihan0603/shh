<view class="rec-page">
  <view class="rec-body">
    <view wx:if="{{loading}}" class="rec-state">正在读取预订…</view>
    <view wx:elif="{{error}}" class="rec-state">
      <view>{{error}}</view>
      <button wx:if="{{needsName}}" class="rec-button rec-secondary" bindtap="openAccount">填写员工姓名</button>
      <button wx:elif="{{id}}" class="rec-button rec-secondary" bindtap="load">重新读取</button>
    </view>
    <block wx:elif="{{card}}">
      <view wx:if="{{!card.servicePhone}}" class="rec-alert notify-notice">
        {{card.serviceName || '原接单员工'}}的服务手机号未设置。请原接单员工到「我的 → 服务手机号」填写，也可联系管理员。
      </view>
      <block wx:if="{{smsOnly}}">
        <view class="rec-panel notify-panel">
          <view class="rec-title">收件人手机号</view>
          <text class="notify-phone" user-select>{{phone || '未登记手机号'}}</text>
          <button class="rec-button rec-primary notify-action" loading="{{copyStatus === 'copying' || opening}}" disabled="{{copyStatus === 'copying' || opening}}" bindtap="copy">{{phone && canCompose ? '复制原文并打开短信' : '复制完整原文'}}</button>
          <view wx:if="{{!phone}}" class="rec-muted notify-hint">请在订单中补充手机号。</view>
          <view wx:elif="{{smsHint}}" class="rec-muted notify-hint">{{smsHint}}</view>
          <view wx:elif="{{!canCompose}}" class="rec-muted notify-hint">复制后请手动打开手机短信，填写上方号码并粘贴正文。</view>
          <view wx:else class="rec-muted notify-hint">打开短信后，长按输入框粘贴正文，核对后发送。</view>
          <view wx:if="{{copyStatus === 'success' && !opening}}" class="notify-success">已复制完整原文。</view>
          <view wx:elif="{{copyStatus === 'failed'}}" class="rec-alert notify-feedback">复制失败，请长按下方正文手动复制，再打开手机短信发送。</view>
          <text wx:if="{{smsDiagnostic}}" class="rec-muted notify-diagnostic" user-select>微信错误（{{smsDiagnostic}}）</text>
        </view>
        <view class="rec-panel notify-panel">
          <view class="rec-title">完整短信正文</view>
          <text class="notify-message" user-select>{{message}}</text>
        </view>
      </block>
      <block wx:else>
        <view class="rec-panel notify-panel">
          <view class="notify-heading">
            <view class="rec-title">{{editingText ? '编辑预订文字' : '预订图文'}}</view>
            <button wx:if="{{!editingText}}" class="notify-edit" disabled="{{generating || chatOpening}}" bindtap="editMessage">编辑文字</button>
          </view>
          <block wx:if="{{editingText}}">
            <textarea class="notify-editor" aria-label="预订文字" value="{{editText}}" maxlength="{{-1}}" auto-height bindinput="changeText" />
            <view class="notify-editor-actions">
              <button class="rec-button rec-secondary" bindtap="finishEditing" data-cancel="{{true}}">取消</button>
              <button class="rec-button rec-primary" disabled="{{!editText}}" bindtap="finishEditing">完成编辑</button>
            </view>
          </block>
          <block wx:else>
            <text wx:if="{{!invitationImagePath}}" class="notify-message" user-select>{{message}}</text>
            <view wx:if="{{generating}}" class="rec-state">正在生成预订图…</view>
            <block wx:elif="{{imageError}}">
              <view class="rec-alert notify-feedback">{{imageError}}</view>
              <button class="rec-button rec-secondary notify-action" bindtap="generateImage">重新生成</button>
            </block>
            <block wx:elif="{{invitationImagePath}}">
              <button wx:if="{{canOpenChat || canShareImageMenu}}" class="rec-button rec-primary notify-action" loading="{{chatOpening}}" disabled="{{chatOpening}}" bindtap="openChat">{{canOpenChat ? '选择微信联系人' : '发送给朋友'}}</button>
              <view wx:if="{{chatNotice || !(canOpenChat || canShareImageMenu)}}" class="rec-muted notify-hint">{{chatNotice || '长按下方预订图，选择「发送给朋友」。'}}</view>
              <image class="notify-poster" src="{{invitationImagePath}}" mode="widthFix" show-menu-by-longpress="{{true}}" aria-label="{{message}}" />
            </block>
          </block>
        </view>
        <view wx:if="{{cloudEnabled || cloudStatus === 'accepted' || cloudStatus === 'pending' || cloudNote}}" class="rec-panel notify-panel">
          <view class="rec-title">门店短信服务</view>
          <view wx:if="{{cloudStatus === 'accepted'}}" class="notify-success">短信平台已受理本次预订通知。</view>
          <view wx:elif="{{cloudStatus === 'pending'}}" class="rec-alert notify-feedback">短信受理结果待核对，请先在门店短信平台查询。</view>
          <block wx:elif="{{cloudEnabled}}">
            <view class="rec-muted notify-hint">{{cloudFields}}</view>
            <button class="rec-button rec-secondary notify-action" loading="{{sending}}" disabled="{{sending}}" bindtap="sendCloud">用门店短信发送</button>
          </block>
          <view wx:else class="rec-muted notify-hint">{{cloudNote}}</view>
        </view>
        <view wx:if="{{notice}}" class="rec-alert notify-feedback">{{notice}}</view>
      </block>
    </block>
  </view>
  <canvas wx:if="{{card && !smsOnly}}" type="2d" id="invitation-image-canvas" class="notify-canvas" aria-hidden="{{true}}" />
</view>
