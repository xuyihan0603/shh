@import "../../lib/reception.wxss";

.board-hero {
  position: relative;
  display: flex;
  align-items: center;
  box-sizing: border-box;
  min-height: 206rpx;
  padding: 32rpx 28rpx 52rpx;
  overflow: hidden;
  background: #103947;
  color: #fffdf6;
}

.board-hero-image {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.board-hero::after {
  position: absolute;
  inset: 0;
  background: linear-gradient(90deg, rgba(10, 35, 43, .88), rgba(10, 35, 43, .63) 52%, rgba(10, 35, 43, .08) 100%);
  content: "";
}

.board-brand {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  gap: 20rpx;
  width: 100%;
}

.board-emblem {
  position: relative;
  flex: 0 0 84rpx;
  width: 84rpx;
  height: 84rpx;
  overflow: hidden;
  border-radius: 12rpx;
  background: #fff;
}

.board-emblem-image {
  position: absolute;
  top: 7rpx;
  left: -17rpx;
  width: 118rpx;
  height: 107rpx;
}

.board-identity {
  flex: 1;
  min-width: 0;
  max-width: 60%;
}

.board-store {
  color: #f4dda8;
  font-size: 46rpx;
  font-weight: 700;
  line-height: 1.17;
  overflow-wrap: break-word;
}

.board-identity-meta {
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
  gap: 6rpx 16rpx;
  margin-top: 10rpx;
  font-size: 23rpx;
  line-height: 1.35;
}

.board-role {
  color: #e0eded;
}

.board-body {
  position: relative;
  z-index: 2;
  margin-top: -24rpx;
  padding-top: 0;
}

.board-controls {
  padding: 15rpx 18rpx;
  box-shadow: 0 5rpx 20rpx rgba(16, 57, 71, .06);
}

.board-date {
  gap: 8rpx;
}

.board-date-arrow {
  display: flex;
  flex: 0 0 68rpx;
  align-items: center;
  justify-content: center;
  height: 66rpx;
  margin: 0;
  padding: 0;
  border-radius: 12rpx;
  background: #edf2f2;
  color: #103947;
}

.board-date-arrow::after,
.board-meal::after,
.board-type::after {
  border: 0;
}

.board-arrow {
  width: 12rpx;
  height: 12rpx;
  margin-left: -5rpx;
  transform: rotate(45deg);
  border: solid currentColor;
  border-width: 3rpx 3rpx 0 0;
}

.board-arrow-previous {
  margin-right: -5rpx;
  margin-left: 0;
  transform: rotate(-135deg);
}

.board-date-picker {
  flex: 1;
  min-width: 0;
}

.board-date-label {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  min-height: 66rpx;
  color: #103947;
  font-size: 30rpx;
  font-weight: 650;
}

.board-date-text {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.board-caret {
  flex: 0 0 9rpx;
  height: 9rpx;
  margin-top: -5rpx;
  transform: rotate(45deg);
  border: solid #617c84;
  border-width: 0 2rpx 2rpx 0;
}

.board-today {
  flex-shrink: 0;
  font-size: 24rpx;
}

.board-meals {
  display: flex;
  gap: 6rpx;
  margin-top: 12rpx;
  padding: 5rpx;
  border-radius: 14rpx;
  background: #edf2f2;
}

.board-meal {
  flex: 1;
  min-width: 0;
  height: 59rpx;
  margin: 0;
  padding: 0;
  border-radius: 10rpx;
  background: transparent;
  color: #435e67;
  font-size: 28rpx;
  line-height: 59rpx;
}

.board-meal-active {
  background: #103947;
  color: #fffdf6;
  font-weight: 650;
}

.board-summary {
  display: flex;
  margin-top: 16rpx;
  padding: 20rpx 0;
}

.board-metric {
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  min-width: 0;
}

.board-metric + .board-metric {
  border-left: 1rpx solid #e1e8e6;
}

.board-metric-value {
  color: #103947;
  font-size: 45rpx;
  font-variant-numeric: tabular-nums;
  font-weight: 700;
  line-height: 1;
}

.board-metric-free {
  color: #276550;
}

.board-metric-taken {
  color: #865824;
}

.board-metric-label {
  color: #4b6470;
  font-size: 24rpx;
}

.board-heading {
  gap: 12rpx;
  min-height: 64rpx;
  margin: 18rpx 0 12rpx;
}

.board-heading .rec-title {
  flex-shrink: 0;
}

.board-types {
  display: flex;
  gap: 4rpx;
  padding: 4rpx;
  border-radius: 12rpx;
  background: #e9efee;
}

.board-type {
  min-width: 82rpx;
  margin: 0;
  padding: 0 12rpx;
  border-radius: 9rpx;
  background: transparent;
  color: #4b6470;
  font-size: 24rpx;
  line-height: 50rpx;
  white-space: nowrap;
}

.board-type-active {
  background: #fffcf5;
  color: #103947;
  font-weight: 650;
  box-shadow: 0 1rpx 4rpx rgba(16, 57, 71, .09);
}

.board-floors {
  margin-bottom: 14rpx;
}

.board-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 10rpx;
}

.board-desk {
  display: flex;
  align-items: flex-start;
  flex-direction: column;
  box-sizing: border-box;
  width: 100%;
  min-width: 0;
  min-height: 158rpx;
  margin: 0;
  padding: 13rpx 10rpx 11rpx;
  border: 1rpx solid #dae4e1;
  border-radius: 15rpx;
  background: #fffefa;
  color: #103947;
  line-height: 1.3;
  text-align: left;
}

.board-desk::after {
  border: 0;
}

.board-desk[disabled] {
  background: #fffefa;
  color: #103947;
}

.board-desk-booked {
  border-color: #e5d5bb;
  background: #fff8eb;
  box-shadow: inset 4rpx 0 0 #bd9354;
}

.board-desk-arrived {
  border-color: #cfe0df;
  background: #eff6f5;
  box-shadow: inset 4rpx 0 0 #679a99;
}

.board-desk-settled {
  border-color: #e2e1db;
  background: #f2f2ed;
}

.board-desk-selected {
  border-color: #1d5a6b;
  background: #e8f1f3;
  box-shadow: inset 0 0 0 1rpx #1d5a6b;
}

.board-desk-name {
  width: 100%;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.2;
  overflow-wrap: break-word;
}

.board-desk-capacity,
.board-desk-meta {
  width: 100%;
  margin-top: 4rpx;
  color: #495f65;
  font-size: 22rpx;
  overflow-wrap: break-word;
}

.board-desk-capacity {
  color: #173640;
  font-weight: 600;
}

.board-desk-footer {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 5rpx 8rpx;
  width: 100%;
  margin-top: auto;
  padding-top: 8rpx;
}

.board-desk .rec-status {
  padding: 4rpx 9rpx;
  font-size: 21rpx;
  font-weight: 600;
}

.board-desk-owner {
  max-width: 100%;
  color: #68451e;
  font-size: 25rpx;
  font-weight: 650;
  overflow-wrap: break-word;
}

.board-desk-selected .rec-status {
  background: #103947;
  color: #fffdf6;
}

.board-dock {
  gap: 12rpx;
}

.board-dock .rec-button {
  flex-shrink: 0;
  padding: 0 19rpx;
  font-size: 26rpx;
}

.board-booking-button {
  background: #d1aa6b;
  color: #103947;
}

.board-selection {
  display: flex;
  flex: 1;
  flex-direction: column;
  gap: 4rpx;
  min-width: 0;
}

.board-selection-title,
.board-selection-detail {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.board-selection-title {
  color: #103947;
  font-size: 27rpx;
  font-weight: 650;
}

.board-selection-detail {
  color: #4b6470;
  font-size: 23rpx;
}
