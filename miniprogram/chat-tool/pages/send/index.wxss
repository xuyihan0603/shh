.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #f6f4ee;
  color: #103947;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
}

.navigation {
  box-sizing: content-box;
  display: flex;
  flex-shrink: 0;
  align-items: center;
  min-height: 44px;
  padding-left: 28rpx;
  border-bottom: 2rpx solid #bd9354;
  background: #103947;
}

.back {
  margin: 0;
  padding: 0 12rpx;
  background: transparent;
  color: #f6f4ee;
  font-size: 28rpx;
  line-height: 44px;
}

.title {
  flex-shrink: 0;
  padding: 24rpx 28rpx 16rpx;
  font-size: 36rpx;
  font-weight: 700;
}

.content {
  flex: 1;
  height: 0;
}

.composer {
  padding: 0 28rpx 28rpx;
  padding-bottom: calc(28rpx + env(safe-area-inset-bottom));
}

.message {
  box-sizing: border-box;
  display: block;
  width: 100%;
  padding: 24rpx;
  border: 1rpx solid #d5e1e1;
  border-radius: 16rpx;
  background: #fafcfb;
  color: #103947;
  font-size: 29rpx;
  line-height: 1.65;
}

.notice {
  margin-top: 16rpx;
  color: #405b63;
  font-size: 27rpx;
  line-height: 1.5;
}

.send {
  width: 100%;
  margin: 18rpx 0 0;
  border-radius: 14rpx;
  background: #103947;
  color: #f6f4ee;
  font-size: 29rpx;
  font-weight: 650;
  line-height: 84rpx;
}

.send[disabled] {
  background: #e8f1f1;
  color: #587079;
}

button::after {
  border: 0;
}
