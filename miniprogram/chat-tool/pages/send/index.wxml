<view class="page">
  <view class="navigation" style="padding-top: {{statusBarHeight}}px;">
    <button class="back" bindtap="goBack">返回</button>
  </view>
  <view wx:if="{{hasDraft}}" class="title">预订正文</view>
  <scroll-view type="list" class="content" scroll-y>
    <view class="composer">
      <form wx:if="{{hasDraft}}" bind:submitToGroup="onSubmitToGroup">
        <textarea
          class="message"
          aria-label="预订正文"
          value="{{text}}"
          maxlength="{{-1}}"
          auto-height
          bindinput="onInput"
        />
        <button
          class="send"
          form-type="submitToGroup"
          need-show-entrance="{{false}}"
          disabled="{{!hasText || submitted}}"
        >发送文字</button>
      </form>
      <view wx:if="{{notice}}" class="notice">{{notice}}</view>
    </view>
  </scroll-view>
</view>
