<view class="page">
  <view class="navigation" style="padding-top: {{statusBarHeight}}px;">
    <button class="back" bindtap="goBack">返回</button>
  </view>
  <scroll-view type="list" class="content" scroll-y>
    <view class="composer">
      <view class="title">发送微信文字</view>
      <view class="hint">核对正文后发送到所选微信会话。</view>
      <form bind:submitToGroup="onSubmitToGroup">
        <textarea
          class="message"
          value="{{text}}"
          placeholder="输入或粘贴要发送的正文"
          placeholder-class="placeholder"
          aria-label="消息正文"
          maxlength="{{-1}}"
          auto-height
          bindinput="onInput"
        />
        <button
          class="send"
          form-type="submitToGroup"
          need-show-entrance="{{false}}"
          disabled="{{!hasText}}"
        >发送文字</button>
      </form>
      <view wx:if="{{submitted}}" class="result">请在微信聊天中查看发送结果。</view>
    </view>
  </scroll-view>
</view>
